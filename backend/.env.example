# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/finance_manager
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/finance_manager
MONGO_URI=mongodb://127.0.0.1:27017/finance_manager

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Port the backend server runs on
PORT=5000

# URL of the Python ML service (Module 2 - expense categorization & Module 7 anomaly detection)
ML_SERVICE_URL=http://localhost:8000

# Module 7 - Email Alert Configuration (Optional)
# If left unset, the system uses Ethereal test mail / logger automatically without crashing!
# For real Gmail delivery:
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_gmail_app_password
# Or custom SMTP:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
# EMAIL_FROM="Finance Manager Alerts" <alerts@financemanager.local>
